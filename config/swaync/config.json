{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "overlay",
  "layer-shell": true,
  "cssPriority": "user",
  "notification-window-preferred-output": "",
  "control-center-preferred-output": "",
  "control-center-margin-top": 10,
  "control-center-margin-bottom": 10,
  "control-center-margin-right": 10,
  "control-center-margin-left": 10,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-icon-size": 48,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "relative-timestamps": true,
  "control-center-width": 420,
  "control-center-height": 600,
  "notification-window-width": 420,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "No hay notificaciones",
  "script-fail-notify": true,
  "notification-visibility": {
    "whatsie-app": {
      "state": "enabled",
      "app-name": "(?i).*whatsie.*|.*whatsapp.*"
    },
    "whatsie-desktop": {
      "state": "enabled",
      "desktop-entry": "(?i).*whatsie.*"
    },
    "antigravity": {
      "state": "enabled",
      "app-name": "(?i).*antigravity.*"
    },
    "claude": {
      "state": "enabled",
      "app-name": "(?i).*claude.*"
    },
    "firefox": {
      "state": "enabled",
      "app-name": "(?i).*firefox.*|.*mozilla.*"
    },
    "devices": {
      "state": "enabled",
      "app-name": "(?i).*device.*|.*udisk.*|.*bluetooth.*|.*usb.*"
    }
  },
  "widgets": [
    "title",
    "dnd",
    "buttons-grid",
    "mpris",
    "volume",
    "backlight",
    "notifications"
  ],
  "widget-config": {
    "buttons-grid": {
      "actions": [
        {
          "label": "󰂚 Silenciar Apps",
          "type": "normal",
          "command": "/home/kuro/.config/swaync/dnd-app-manager.py"
        },
        {
          "label": "⚙ Ajustes Sistema",
          "type": "normal",
          "command": "/home/kuro/.local/bin/hypr-control-center"
        }
      ]
    },
    "notifications": {
      "vexpand": true
    },
    "title": {
      "text": "Notificaciones",
      "clear-all-button": true,
      "button-text": "Limpiar todo"
    },
    "dnd": {
      "text": "No Molestar"
    },
    "mpris": {
      "blacklist": [],
      "autohide": true,
      "show-album-art": "always"
    },
    "volume": {
      "label": "🔊 "
    },
    "backlight": {
      "label": "☀️ "
    }
  }
}
