* {
    bg-col:       rgba(15, 17, 26, 0.90);
    bg-col-light: rgba(30, 30, 46, 0.85);
    border-col:   #b30000;
    selected-col: #b30000;
    selected-fg:  #ffffff;
    fg-col:       #cdd6f4;
    grey:         #6c7086;
    font: "JetBrains Mono 10.5";
}

window {
    width: 650px;
    border: 2px;
    border-color: @border-col;
    background-color: @bg-col;
    border-radius: 12px;
    location: center;
    anchor: center;
    padding: 14px;
}

mainbox {
    background-color: transparent;
    children: [ "inputbar", "listview" ];
    spacing: 12px;
}

inputbar {
    background-color: @bg-col-light;
    border-radius: 8px;
    padding: 8px 12px;
    children: [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color: @border-col;
    font: "JetBrains Mono Bold 11";
    padding: 0 8px 0 0;
}

entry {
    background-color: transparent;
    text-color: @fg-col;
    placeholder: "Cambiar a ventana...";
    placeholder-color: @grey;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 7;
    spacing: 6px;
    fixed-height: false;
    dynamic: true;
}

element {
    background-color: @bg-col-light;
    text-color: @fg-col;
    padding: 8px 12px;
    border-radius: 8px;
    orientation: horizontal;
    children: [ element-icon, element-text ];
    spacing: 12px;
}

element-icon {
    size: 26px;
    background-color: transparent;
    vertical-align: 0.5;
}

element selected {
    background-color: @selected-col;
    text-color: @selected-fg;
}

element-text {
    background-color: inherit;
    text-color: inherit;
    vertical-align: 0.5;
}
